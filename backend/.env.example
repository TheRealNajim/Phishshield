PORT=3000
# Where the JSON stores live (history.jsonl, institutions.json, teams.json).
# Defaults to backend/data; the test suite overrides this with a temp dir.
# PHISHSHIELD_DATA_DIR=
# Real sandbox mode (hackathon). Leave MOCK_SANDBOX=true for local dev.
MOCK_SANDBOX=true
CREATEOS_SANDBOX_API_KEY=
CREATEOS_SANDBOX_BASE_URL=
# Known-good bank domains, comma separated
KNOWN_BANK_DOMAINS=chase.com,bankofamerica.com,gtbank.com,accessbankplc.com

# Natural-language verdict — set at least one provider, or scans answer 503.
# LLM_PROVIDER picks the primary: auto (default) | openai | gemini.
# "auto" prefers whichever provider has a key, OpenAI-compatible first.
LLM_PROVIDER=auto

# --- OpenAI-compatible (defaults target Groq — free, fast, no card) ----------
# The same settings work for Cerebras, OpenRouter, Mistral, ... — only the
# base URL, key and model change.
# Get a free Groq key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# LLM_FALLBACK_MODELS=llama-3.1-8b-instant

# --- Gemini ------------------------------------------------------------------
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Comma-separated fallbacks, tried in order when the primary is retired,
# overloaded or rate-limited. Defaults are built in if omitted.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Per-model request timeout, and the overall budget across the whole provider
# chain. The LLM_* names are preferred; GEMINI_* still works for back-compat.
LLM_TIMEOUT_MS=20000
LLM_TOTAL_BUDGET_MS=60000

# Stripe paywall — NOT used for the hackathon; leave blank.
STRIPE_PAYMENT_LINK=
STRIPE_WEBHOOK_SECRET=
TEAMS_KEY=demo-teams-key

# Trust API: base URL baked into verification links, and the admin key that
# registers institutions (falls back to TEAMS_KEY if unset).
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_KEY=demo-admin-key
